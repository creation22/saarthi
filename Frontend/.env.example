# =============================================================================
# Legal Sahayak — Frontend environment
# =============================================================================
# Copy to `.env.local` for local overrides (gitignored).
# Vercel: Project Settings → Environment Variables (same names, Production + Preview).
#
# Do not commit real keys. `clerk env pull` may write VITE_* names — rename to
# CLERK_PUBLISHABLE_KEY below or keep both until the next pull.

# --- Backend API ---
# Production: https://your-api-host.example.com/api
API_URL=http://localhost:5000/api

# --- Clerk (https://dashboard.clerk.com → saarthi → API Keys) ---
# Browser-safe publishable key only
CLERK_PUBLISHABLE_KEY=

# Server / CLI only — never exposed to the Vite client bundle
CLERK_SECRET_KEY=
