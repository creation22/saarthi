# =============================================================================
# MySaarthi — Frontend environment
# =============================================================================
# Copy to `.env.local` for local overrides (gitignored).
# Vercel: Project Settings → Environment Variables (Production + Preview).
#
# Production backend (Render):
#   https://saarthi-ug2t.onrender.com

# --- Backend API ---
API_URL=https://saarthi-ug2t.onrender.com/api
# Local backend instead: API_URL=http://localhost:5000/api

# --- Clerk (https://dashboard.clerk.com → saarthi → API Keys) ---
CLERK_PUBLISHABLE_KEY=

# CLI / local only — not bundled by Vite
CLERK_SECRET_KEY=
