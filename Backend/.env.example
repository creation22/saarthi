PORT=5000
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/legalapp

# Sarvam AI  (https://www.sarvam.ai)
SARVAM_API_KEY=your_sarvam_api_key

# Pinecone  (https://www.pinecone.io)
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=legal-corpus

# LLM — defaults to OpenAI when OPENAI_API_KEY is set (cheap chat model)
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key
OPENAI_CHAT_MODEL=gpt-4o-mini
# Statute search embeddings — keep ada-002 unless you re-run node scripts/ingest.js
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# Optional Anthropic fallback (uses haiku by default, not Opus)
# LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_64_char_random_secret_here
